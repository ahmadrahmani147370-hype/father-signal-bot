# ================= FATHER SIGNAL BOT configuration =================
# Copy to .env and edit:  cp .env.example .env
# Analysis only. No Binance API key is needed or used (public market data only).

# ---- Telegram (optional; if empty, alerts are printed to the console) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Binance USD-M Futures public REST ----
# Change only if fapi.binance.com is blocked in your region (e.g. a mirror/proxy you trust).
BINANCE_BASE_URL=https://fapi.binance.com
# Minimum seconds between two REST requests (controlled polling, phone friendly)
REQUEST_MIN_INTERVAL=0.12
# Stop and wait if the used request weight per minute goes above this (Binance limit is 2400)
MAX_WEIGHT_PER_MIN=1200
HTTP_TIMEOUT=10
HTTP_MAX_RETRIES=5
# Parallel kline downloads (keep low on phones: 2-4)
MAX_WORKERS=3

# ---- Universe / scanner ----
UNIVERSE_SIZE=100
UNIVERSE_REFRESH_MIN=15
MIN_QUOTE_VOLUME_USDT=20000000
MAX_SPREAD_BPS=5
MIN_HISTORY_CANDLES=210
# Seconds to wait after a candle closes before fetching (lets Binance finalise the candle)
CANDLE_CLOSE_DELAY_SEC=3

# ---- Signal engine ----
VOLUME_SPIKE_RATIO=1.5
EMA_FAST=20
EMA_SLOW=50
RSI_PERIOD=14
ATR_PERIOD=14
# Minimum engineering score to send a Telegram alert (75 = Qualified candidate)
MIN_ALERT_SCORE=75
# 1 = only alert when the candle volume is a spike (VOLUME_SPIKE_RATIO); 5m trend must always agree
REQUIRE_VOLUME_CONFIRMATION=1
# Cap alerts per scan (market-wide moves trigger many coins at once) - best scores are sent first
MAX_ALERTS_PER_SCAN=5
# Do not alert the same coin + direction again within N minutes
ALERT_COOLDOWN_MIN=15
# Adjust pattern weights using your own stored backtest results (1 = on, 0 = off)
USE_BACKTEST_PATTERN_WEIGHTS=1

# ---- Backtest ----
FEE_PCT_PER_SIDE=0.05
SLIPPAGE_PCT_PER_SIDE=0.02
TP_ATR_MULT=1.5
SL_ATR_MULT=1.0
MAX_HOLD_BARS=30
TRAIN_FRACTION=0.6
VALIDATION_FRACTION=0.2
MIN_OOS_TRADES=200

# ---- Storage ----
DB_PATH=data/father.db
CANDLE_RETENTION_DAYS=30
LOG_LEVEL=INFO
